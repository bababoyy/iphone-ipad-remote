    "faceB":    { "shape": { "type": "circle" }, "fill": "#4e3138", "heldFill": "#537fa8", "fg": "#ffb8c0", "stroke": "#63758e", "strokeWidth": 1.2, "labelScale": 0.77 },
    "faceX":    { "shape": { "type": "circle" }, "fill": "#25483c", "heldFill": "#537fa8", "fg": "#a3f2ce", "stroke": "#63758e", "strokeWidth": 1.2, "labelScale": 0.77 },
