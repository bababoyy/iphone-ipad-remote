{
  "version": 1,
  "notes": "Single source of truth for the native gamepad layout. Read by iphone-app (embedded at build time via scripts/embed_layout.py) and by scripts/render_layout_svg.py. Positions are fractions of the canvas; radii come from 'sizes' (points, derived from the canvas' short side). Array order is draw order and touch priority for equal radii.",
  "chrome": { "headerHeight": 48, "headerGap": 4 },
  "hitSlop": { "stick": 6, "button": 8, "directional": 11 },
  "sizes": {
