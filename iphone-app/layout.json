    "face":     { "landscape": { "short": 0.067, "min": 16, "max": 25 },
                  "portrait":  { "short": 0.067, "min": 16, "max": 25 } },
    "dpad":     { "landscape": { "short": 0.062, "min": 16, "max": 23 },
                  "portrait":  { "short": 0.062, "min": 16, "max": 23 } },
    "shoulder": { "landscape": { "short": 0.082, "min": 19, "max": 31 },
                  "portrait":  { "short": 0.064, "min": 19, "max": 26 } },
