    "shoulder": { "shape": { "type": "rect", "halfWidth": 1.39, "halfHeight": 0.56, "corner": 0.49 }, "fill": "#111a29", "heldFill": "#557ca7", "fg": "#d9e4f3", "stroke": "#526681", "strokeWidth": 1, "labelScale": 0.58 },
